generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(320)
  fullName     String?   @map("full_name") @db.VarChar(120)
  phoneNumber  String?   @map("phone_number") @db.VarChar(16)
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  emailVerified Boolean @default(false) @map("email_verified")
  verificationCodeHash String? @map("verification_code_hash") @db.VarChar(64)
  verificationCodeExpiresAt DateTime? @map("verification_code_expires_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  rentals      Rental[]

  @@map("users")
}

model Bike {
  id        String    @id @db.VarChar(80)
  name      String    @db.VarChar(120)
  type      String    @db.VarChar(80)
  station   String    @db.VarChar(160)
  price     Int
  image     String?
  available Boolean   @default(true)
  rentals   Rental[]

  @@map("bikes")
}

model Rental {
  id         BigInt    @id @default(autoincrement())
  bikeId     String    @map("bike_id") @db.VarChar(80)
  userId     String    @map("user_id") @db.Uuid
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  returnedAt DateTime? @map("returned_at") @db.Timestamptz(6)
  bike       Bike      @relation(fields: [bikeId], references: [id], onDelete: Restrict)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, startedAt(sort: Desc)])
  @@index([bikeId, returnedAt])
  @@map("rentals")
}
